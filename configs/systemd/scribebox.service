[Unit]
Description=ScribeBox Transcription Appliance
After=graphical-session.target sound.target
Wants=sound.target

[Service]
Type=simple
User=scribebox
Environment=DISPLAY=:0
Environment=SCRIBEBOX_MODELS_DIR=/opt/scribebox/models
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/python3 -m scribebox --models-dir /opt/scribebox/models --data-dir /data/scribebox
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
