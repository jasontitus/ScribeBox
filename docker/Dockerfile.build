FROM debian:bookworm-slim

# Build environment for ScribeBox USB image
# Contains all tools needed to bootstrap a Debian rootfs and create a bootable image

RUN apt-get update && apt-get install -y --no-install-recommends \
    debootstrap \
    grub-pc-bin \
    grub-efi-amd64-bin \
    grub-common \
    parted \
    dosfstools \
    e2fsprogs \
    mount \
    kmod \
    udev \
    xz-utils \
    curl \
    wget \
    ca-certificates \
    git \
    build-essential \
    cmake \
    python3 \
    python3-pip \
    python3-numpy \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/scribebox
